{
  "reporter": [
    "text",
    "html",
    "lcov"
  ],
  "exclude": [
    "coverage/**",
    "dist/**",
    "node_modules/**",
    "out/test/**",
    "src/test/**",
    "src-ui/**",
    "vite.*.config.ts",
    "vite.shared.ts"
  ],
  "extension": [
    ".js",
    ".mjs",
    ".ts"
  ],
  "exclude-after-remap": false,
  "sourceMap": true
}
