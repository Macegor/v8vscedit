{
  "Окружить: Если": {
    "prefix": "SurroundIf",
    "body": [
      "Если ${1:Условие} Тогда",
      "\t${TM_SELECTED_TEXT}",
      "КонецЕсли;$0"
    ],
    "description": "Окружить выделенный код условием Если"
  },
  "Окружить: Если иначе": {
    "prefix": "SurroundIfElse",
    "body": [
      "Если ${1:Условие} Тогда",
      "\t${TM_SELECTED_TEXT}",
      "Иначе",
      "\t${0}",
      "КонецЕсли;"
    ],
    "description": "Окружить выделенный код условием Если с веткой Иначе"
  },
  "Окружить: Попытка": {
    "prefix": "SurroundTry",
    "body": [
      "Попытка",
      "\t${TM_SELECTED_TEXT}",
      "Исключение",
      "\t${0:ВызватьИсключение;}",
      "КонецПопытки;"
    ],
    "description": "Окружить выделенный код обработкой исключения"
  },
  "Окружить: Пока": {
    "prefix": "SurroundWhile",
    "body": [
      "Пока ${1:Условие} Цикл",
      "\t${TM_SELECTED_TEXT}",
      "КонецЦикла;$0"
    ],
    "description": "Окружить выделенный код циклом Пока"
  },
  "Окружить: Для каждого": {
    "prefix": "SurroundForEach",
    "body": [
      "Для Каждого ${1:Элемент} Из ${2:Коллекция} Цикл",
      "\t${TM_SELECTED_TEXT}",
      "КонецЦикла;$0"
    ],
    "description": "Окружить выделенный код циклом Для Каждого"
  },
  "Окружить: Процедура": {
    "prefix": "SurroundProcedure",
    "body": [
      "Процедура ${1:ИмяПроцедуры}(${2})${3}",
      "\t${TM_SELECTED_TEXT}",
      "КонецПроцедуры$0"
    ],
    "description": "Окружить выделенный код процедурой"
  },
  "Окружить: Функция": {
    "prefix": "SurroundFunction",
    "body": [
      "Функция ${1:ИмяФункции}(${2})${3}",
      "\t${TM_SELECTED_TEXT}",
      "\tВозврат ${0:Результат};",
      "КонецФункции"
    ],
    "description": "Окружить выделенный код функцией"
  },
  "Окружить: Область": {
    "prefix": "SurroundRegion",
    "body": [
      "#Область ${1:ИмяОбласти}",
      "${TM_SELECTED_TEXT}",
      "#КонецОбласти$0"
    ],
    "description": "Окружить выделенный код областью"
  }
}
