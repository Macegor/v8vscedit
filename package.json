{
  "name": "v8vscedit",
  "displayName": "Редактор конфигураций 1С",
  "description": "Редактор конфигураций и расширений 1С:Предприятие — навигация по метаданным, LSP для BSL, работа с XML-выгрузкой",
  "version": "0.4.2",
  "publisher": "macegor",
  "license": "GPL-3.0-only",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Macegor/v8vscedit.git"
  },
  "homepage": "https://github.com/Macegor/v8vscedit#readme",
  "bugs": {
    "url": "https://github.com/Macegor/v8vscedit/issues"
  },
  "keywords": [
    "1c",
    "1с",
    "bsl",
    "onec",
    "метаданные",
    "конфигурация",
    "расширение конфигурации"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/Configuration.xml",
    "onView:v8vsceditUniversal",
    "onView:v8vsceditChanges",
    "onLanguage:bsl",
    "onCommand:v8vscedit.openAiSettings",
    "onCommand:v8vscedit.refresh"
  ],
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "v8vscedit",
          "title": "Редактор конфигураций",
          "icon": "src/icons/activity-bar.svg"
        },
        {
          "id": "v8vsceditDynamicPanelContainer",
          "title": "Дин. панель",
          "icon": "src/icons/dynamic-panel.svg"
        },
        {
          "id": "v8vsceditChangesContainer",
          "title": "Изменения метаданных",
          "icon": "src/icons/changes.svg"
        }
      ]
    },
    "views": {
      "v8vscedit": [
        {
          "id": "v8vsceditUniversal",
          "name": "Редактор конфигураций",
          "type": "webview"
        }
      ],
      "v8vsceditChangesContainer": [
        {
          "id": "v8vsceditChanges",
          "name": "Изменения метаданных",
          "type": "webview"
        }
      ],
      "v8vsceditDynamicPanelContainer": [
        {
          "id": "v8vsceditDynamicPanel",
          "name": "Дин. панель",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "v8vscedit.refresh",
        "title": "Обновить",
        "icon": "$(refresh)"
      },
      {
        "command": "v8vscedit.searchTree",
        "title": "Поиск в навигаторе",
        "icon": "$(search)"
      },
      {
        "command": "v8vscedit.clearTreeSearch",
        "title": "Сбросить поиск в навигаторе",
        "icon": "$(close)"
      },
      {
        "command": "v8vscedit.importConfigurations",
        "title": "Импортировать конфигурации из базы",
        "enablement": "!v8vscedit.isUpdatingConfigurations",
        "icon": "$(cloud-download)"
      },
      {
        "command": "v8vscedit.updateChangedConfigurations",
        "title": "Обновить изменённые конфигурации",
        "enablement": "v8vscedit.hasChangedConfigurations && !v8vscedit.isUpdatingConfigurations",
        "icon": {
          "light": "./src/icons/light/externalDataSource.svg",
          "dark": "./src/icons/dark/externalDataSource.svg"
        }
      },
      {
        "command": "v8vscedit.runThinClient",
        "title": "Запустить тонкий клиент",
        "icon": "$(run)"
      },
      {
        "command": "v8vscedit.runConfigurator",
        "title": "Запустить конфигуратор",
        "icon": "$(tools)"
      },
      {
        "command": "v8vscedit.configuration.info",
        "title": "Конфигурация: информация",
        "icon": "$(info)"
      },
      {
        "command": "v8vscedit.configuration.validate",
        "title": "Конфигурация: валидировать",
        "icon": "$(check)"
      },
      {
        "command": "v8vscedit.metadata.info",
        "title": "Метаданные: структура объекта",
        "icon": "$(info)"
      },
      {
        "command": "v8vscedit.metadata.validate",
        "title": "Метаданные: валидировать объект",
        "icon": "$(check)"
      },
      {
        "command": "v8vscedit.role.info",
        "title": "Роль: права",
        "icon": "$(shield)"
      },
      {
        "command": "v8vscedit.role.validate",
        "title": "Роль: валидировать",
        "icon": "$(verified)"
      },
      {
        "command": "v8vscedit.subsystem.info",
        "title": "Подсистема: информация",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "v8vscedit.subsystem.validate",
        "title": "Подсистема: валидировать",
        "icon": "$(verified)"
      },
      {
        "command": "v8vscedit.interface.validate",
        "title": "Командный интерфейс: валидировать",
        "icon": "$(list-tree)"
      },
      {
        "command": "v8vscedit.mxl.info",
        "title": "MXL: структура макета",
        "icon": "$(table)"
      },
      {
        "command": "v8vscedit.mxl.validate",
        "title": "MXL: валидировать макет",
        "icon": "$(check)"
      },
      {
        "command": "v8vscedit.skd.info",
