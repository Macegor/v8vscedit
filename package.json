    ],
    "submenus": [
      {
        "id": "v8vscedit.bslSurroundMenu",
        "label": "Окружить"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "v8vscedit.bsl.surround.if",
          "when": "false"
        },
        {
          "command": "v8vscedit.bsl.surround.ifElse",
          "when": "false"
        },
        {
          "command": "v8vscedit.bsl.surround.try",
          "when": "false"
        },
        {
          "command": "v8vscedit.bsl.surround.while",
          "when": "false"
        },
        {
          "command": "v8vscedit.bsl.surround.forEach",
          "when": "false"
        },
        {
          "command": "v8vscedit.bsl.surround.procedure",
          "when": "false"
        },
        {
          "command": "v8vscedit.bsl.surround.function",
          "when": "false"
        },
        {
          "command": "v8vscedit.bsl.surround.region",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "submenu": "v8vscedit.bslSurroundMenu",
          "when": "editorLangId == bsl && editorHasSelection",
          "group": "1_modification@1"
        }
      ],
      "v8vscedit.bslSurroundMenu": [
        {
          "command": "v8vscedit.bsl.surround.if",
          "when": "editorLangId == bsl && editorHasSelection",
          "group": "conditions@1"
        },
        {
          "command": "v8vscedit.bsl.surround.ifElse",
          "when": "editorLangId == bsl && editorHasSelection",
          "group": "conditions@2"
        },
        {
          "command": "v8vscedit.bsl.surround.try",
          "when": "editorLangId == bsl && editorHasSelection",
          "group": "exceptions@1"
        },
        {
          "command": "v8vscedit.bsl.surround.while",
          "when": "editorLangId == bsl && editorHasSelection",
          "group": "loops@1"
        },
        {
          "command": "v8vscedit.bsl.surround.forEach",
          "when": "editorLangId == bsl && editorHasSelection",
          "group": "loops@2"
        },
        {
          "command": "v8vscedit.bsl.surround.procedure",
          "when": "editorLangId == bsl && editorHasSelection",
          "group": "declarations@1"
        },
        {
          "command": "v8vscedit.bsl.surround.function",
          "when": "editorLangId == bsl && editorHasSelection",
          "group": "declarations@2"
        },
        {
          "command": "v8vscedit.bsl.surround.region",
          "when": "editorLangId == bsl && editorHasSelection",
          "group": "regions@1"
        }
      ]
    },
    "grammars": [
      {
        "language": "bsl",
        "scopeName": "source.bsl",
        "path": "./syntaxes/bsl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "bsl",
        "path": "./snippets/bsl/declarations/procedures.json"
      },
      {
        "language": "bsl",
        "path": "./snippets/bsl/control-flow/conditions.json"
      },
      {
        "language": "bsl",
        "path": "./snippets/bsl/control-flow/loops.json"
      },
      {
        "language": "bsl",
        "path": "./snippets/bsl/control-flow/exceptions.json"
      },
      {
        "language": "bsl",
        "path": "./snippets/bsl/surround/control-flow.json"
      }
    ],
    "languages": [
      {
        "id": "bsl",
        "aliases": [
          "1C BSL",
          "1С"
        ],
        "extensions": [
          ".bsl",
          ".os"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "customEditors": [],
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "annotation:bsl": {
            "foreground": "#C678DD"
          },
          "preprocessor:bsl": {
            "foreground": "#A07850"
          },
          "function:bsl": {
            "foreground": "#DCDCAA"
          },
          "method:bsl": {
            "foreground": "#DCDCAA"
          },
          "parameter:bsl": {
            "foreground": "#9CDCFE"
          }
        }
      }
    },
    "configuration": {
      "title": "1С: Редактор конфигураций",
      "properties": {
        "v8vscedit.lsp.mode": {
          "type": "string",
          "default": "bsl-analyzer",
          "enum": [
            "bsl-analyzer",
            "off"
          ],
          "enumDescriptions": [
            "BSL Analyzer — внешний Rust-сервер (180+ диагностик, быстрый)",
            "Языковой сервер отключён"
          ],
          "description": "Режим языкового сервера BSL"
        },
        "v8vscedit.bslAnalyzer.autoUpdate": {
          "type": "boolean",
          "default": true,
          "description": "Автоматически проверять обновления bsl-analyzer при запуске"
        },
        "v8vscedit.bslAnalyzer.path": {
          "type": "string",
          "default": "",
          "description": "Путь к исполняемому файлу bsl-analyzer (если пусто — скачивается автоматически)"
        },
        "v8vscedit.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Автоматически запускать локальный MCP-сервер после полной загрузки дерева метаданных"
        },
        "v8vscedit.mcp.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Локальный адрес MCP-сервера. В целях безопасности принимаются только 127.0.0.1, localhost или ::1"
        },
        "v8vscedit.mcp.port": {
          "type": "number",
          "default": 38481,
          "description": "Порт локального MCP-сервера. Если порт занят сервером этого же проекта — используется он; если чужим процессом — расширение предложит закрыть его или сменить порт"
        },
        "v8vscedit.aiMcp.bslAnalyzer.autoStart": {
          "type": "boolean",
          "default": false,
          "description": "Автоматически запускать локальные MCP-профили bsl-analyzer из панели ИИ и MCP"
        },
