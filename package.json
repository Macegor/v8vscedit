      {
        "language": "bsl",
        "scopes": {
          "comment": [
            "comment.line.double-slash"
          ],
          "string": [
            "string.quoted.double"
          ],
          "keyword": [
            "keyword.control"
          ],
          "number": [
            "constant.numeric"
          ],
          "operator": [
            "keyword.operator"
          ],
          "function": [
            "entity.name.function"
          ],
          "method": [
            "entity.name.function.member"
          ],
          "variable": [
            "variable.other.readwrite"
          ],
          "parameter": [
            "variable.parameter"
          ],
          "property": [
            "variable.other.property"
          ],
          "class": [
            "entity.name.type"
          ],
          "annotation": [
            "support.function"
          ],
          "preprocessor": [
            "entity.name.type"
          ]
        }
      }
    ]
