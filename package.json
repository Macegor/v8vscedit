        "title": "Установить метку версии",
        "icon": "$(tag)"
      },
      {
        "command": "v8vscedit.bsl.surround.if",
        "title": "Если"
      },
      {
        "command": "v8vscedit.bsl.surround.ifElse",
        "title": "Если / Иначе"
      },
      {
        "command": "v8vscedit.bsl.surround.try",
        "title": "Попытка"
      },
      {
        "command": "v8vscedit.bsl.surround.while",
        "title": "Пока"
      },
      {
        "command": "v8vscedit.bsl.surround.forEach",
        "title": "Для каждого"
      },
      {
        "command": "v8vscedit.bsl.surround.procedure",
        "title": "Процедура"
      },
      {
        "command": "v8vscedit.bsl.surround.function",
        "title": "Функция"
      },
      {
